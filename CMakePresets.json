{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Qt 6 desktop",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "VIBMORY_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "Qt 6 desktop / macOS Apple Silicon",
      "inherits": "desktop",
      "binaryDir": "${sourceDir}/out/macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "core",
      "displayName": "Core without Qt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/core-preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VIBMORY_BUILD_GUI": "OFF",
        "VIBMORY_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitized",
      "inherits": "core",
      "binaryDir": "${sourceDir}/out/sanitized",
      "cacheVariables": {
        "VIBMORY_SANITIZERS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized"
    }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
